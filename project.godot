; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Future Land"
config/description="A farming and life-sim game set in the future."
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/branding/icon.png"
boot_splash/bg_color=Color(0.05, 0.08, 0.12, 1)
boot_splash/stretch_mode=1
boot_splash/image="res://assets/branding/boot_splash.png"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
TimeManager="*res://src/autoload/time_manager.gd"
GameState="*res://src/autoload/game_state.gd"
DialogueManager="*res://src/autoload/dialogue_manager.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
SaveManager="*res://src/autoload/save_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/themes/main_theme.tres"

